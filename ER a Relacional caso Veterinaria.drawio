<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/135.0.0.0 Safari/537.36" version="26.2.14" pages="9">
  <diagram id="_lJ6oXpOfxa9HTaDNfQU" name="enunciado">
    <mxGraphModel dx="1054" dy="635" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="U_6CApAwQMocbdlMteic-1" value="&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;&lt;br&gt;&lt;font size=&quot;4&quot; style=&quot;font-size: 14pt&quot;&gt;&lt;b&gt;Ejemplo Veterinaria&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;1. Del &lt;font color=&quot;#c9211e&quot;&gt;&lt;b&gt;propietario&amp;nbsp;&lt;/b&gt;&lt;/font&gt;interesa: &lt;font color=&quot;#2a6099&quot;&gt;&lt;b&gt;cedula, apellidos, nombres, dirección , telefono&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#2a6099&quot;&gt;&lt;b&gt;s&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2. De la &lt;/span&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;mascota&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;interesa: &lt;/span&gt;&lt;font style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;identificador, nombre, fecha de nacimiento, tipo&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;3. Un propietario&amp;nbsp;&lt;font color=&quot;#158466&quot;&gt;&lt;strike&gt;&lt;b&gt;puede&amp;nbsp;&lt;/b&gt;&lt;/strike&gt;&lt;/font&gt;&lt;font color=&quot;#158466&quot;&gt;&lt;b&gt;llevar una o&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#158466&quot;&gt;varias&lt;/font&gt; mascotas&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;4. Una mascota la lleva &lt;font color=&quot;#158466&quot;&gt;&lt;b&gt;uno y solo un&lt;/b&gt;&lt;/font&gt; propietario&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;5. Del &lt;font color=&quot;#c9211e&quot;&gt;&lt;b&gt;personal de la clínica veterinaria&lt;/b&gt;&lt;/font&gt; interesa un &lt;font color=&quot;#2a6099&quot;&gt;&lt;b&gt;código, el &lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#2a6099&quot;&gt;&lt;b&gt;cédula&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#2a6099&quot;&gt;&lt;b&gt;, nombre&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;6. Entre el personal de la clinica se &lt;font color=&quot;#158466&quot;&gt;&lt;b&gt;distingue&lt;/b&gt;&lt;/font&gt; a los&amp;nbsp;&lt;font color=&quot;#c9211e&quot;&gt;&lt;b&gt;veterinarios&lt;/b&gt;&lt;/font&gt; y los &lt;font color=&quot;#c9211e&quot;&gt;&lt;b&gt;auxiliares&lt;/b&gt;&lt;/font&gt;, pudiendo haber otros tipos&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;* Del veterinario se guarda además su &lt;font color=&quot;#2a6099&quot;&gt;&lt;b&gt;fecha_alta y especialidad&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;* De los auxiliares interesa su &lt;font color=&quot;#2a6099&quot;&gt;&lt;b&gt;base de cotización&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;7. Las mascotas&amp;nbsp;&lt;font color=&quot;#158466&quot;&gt;pasan &lt;/font&gt;&lt;font color=&quot;#158466&quot;&gt;&lt;b&gt;consulta&amp;nbsp;&lt;/b&gt;&lt;/font&gt;con los veterinarios. De manea que:&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;&amp;nbsp; &amp;nbsp;* un veterinario &lt;font color=&quot;#158466&quot;&gt;&lt;b&gt;puede pasar consulta a ninguna o a varias &lt;/b&gt;&lt;/font&gt;máscotas, y &lt;br&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;&amp;nbsp; &amp;nbsp;* una misma mascota de la clinica &lt;font color=&quot;#158466&quot;&gt;ha pasado consulta una o más veces &lt;/font&gt;en &lt;font color=&quot;#2a6099&quot;&gt;&lt;b&gt;fechas&amp;nbsp;&lt;/b&gt;&lt;/font&gt;diferentes con varios veterianrios.&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;&amp;nbsp; &amp;nbsp;* Al pasar consulta se realiza un &lt;font color=&quot;#c9211e&quot;&gt;&lt;b&gt;diagnóstico&lt;/b&gt;&lt;/font&gt;.&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;8. Cada propietario&amp;nbsp;&lt;font color=&quot;#158466&quot;&gt;&lt;b&gt;tiene&lt;/b&gt;&lt;/font&gt; un &lt;font color=&quot;#c9211e&quot;&gt;familiar de contacto&lt;/font&gt; para casos de emergencia.&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;&amp;nbsp; &amp;nbsp;* De este familiar interesa la &lt;font color=&quot;#2a6099&quot;&gt;&lt;b&gt;cédula, nombre y telefono&lt;/b&gt;&lt;/font&gt;.&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;&amp;nbsp; &amp;nbsp;* Si el propietario se da de alta en la clinica veterinaria, el familiar ya no interesa.&lt;/p&gt;&lt;p style=&quot;line-height: 100%; margin-bottom: 0in&quot;&gt;&amp;nbsp; &amp;nbsp;* El familiar &lt;font color=&quot;#158466&quot;&gt;&lt;b&gt;es contacto de un solo&amp;nbsp;&lt;/b&gt;&lt;/font&gt;propietario&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="210" width="700" height="1140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
